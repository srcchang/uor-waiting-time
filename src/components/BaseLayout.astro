---
import '../styles/global.css';
import { base } from '../utils/base';
import { APP, appStoreUrl } from '../config/app';
import {
  locales,
  defaultLocale,
  htmlLang,
  ogLocale,
} from '../i18n/config';
import type { Locale } from '../i18n/config';
import { getTranslations, t } from '../i18n/translations';

interface Props {
  title: string;
  description: string;
  locale: string;
  currentPath?: string;
  jsonLd?: Record<string, any>;
  noindex?: boolean;
}

const {
  title,
  description,
  locale,
  currentPath = '/',
  jsonLd,
  noindex = false,
} = Astro.props;

const canonicalBase = `${Astro.site?.href.replace(/\/$/, '')}${base.replace(/\/$/, '')}`;
const pathSuffix = currentPath === '/' ? '/' : `${currentPath.replace(/\/$/, '')}/`;
const canonicalUrl = `${canonicalBase}/${locale}${pathSuffix}`;
const pageLang = htmlLang[locale as Locale] ?? locale;
const tr = getTranslations(locale as Locale);
const ogImage = `${canonicalBase}/og-default.png`;
---

<!DOCTYPE html>
<html lang={pageLang} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <script is:inline>
      (function () {
        document.documentElement.classList.add('js');
        var params = new URLSearchParams(location.search);
        var themeParam = params.get('theme');
        var dark;
        if (themeParam === 'dark' || themeParam === 'light') {
          dark = themeParam === 'dark';
        } else {
          var stored = localStorage.getItem('theme');
          dark =
            stored === 'dark' ||
            (!stored && window.matchMedia('(prefers-color-scheme: dark)').matches);
        }
        document.documentElement.setAttribute('data-theme', dark ? 'dark' : 'light');
        var embedParam = params.get('embed');
        if (embedParam === '1' || embedParam === 'true') {
          document.documentElement.setAttribute('data-embed', 'true');
        }
      })();
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex" />}

    {locales.map((loc) => (
      <link
        rel="alternate"
        hreflang={loc}
        href={`${canonicalBase}/${loc}${pathSuffix}`}
      />
    ))}
    <link
      rel="alternate"
      hreflang="x-default"
      href={`${canonicalBase}/${defaultLocale}${pathSuffix}`}
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={APP.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={ogLocale[locale as Locale] ?? locale} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    {appStoreUrl && <meta name="apple-itunes-app" content={`app-id=${APP.iosAppId}`} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content="#F7F9FC"
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="#071320"
    />

    <link rel="icon" type="image/png" href={`${base}favicon.png`} />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body class="bg-bg-primary font-sans text-text-primary antialiased">
    <a href="#main" class="skip-link">
      {t(tr, 'common.a11y.skipToContent')}
    </a>
    <slot />
    <script>
      import '../scripts/scroll-reveal';
    </script>
  </body>
</html>
