---
import { base } from '../utils/base';
const canonical = `${Astro.site?.href.replace(/\/$/, '')}${base}en/`;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <script is:inline define:vars={{ base }}>
      (function () {
        var detected = null;
        var langs = navigator.languages || [navigator.language || ''];
        for (var i = 0; i < langs.length && !detected; i++) {
          var lang = (langs[i] || '').toLowerCase();
          if (lang.indexOf('ja') === 0) detected = 'ja';
          else if (lang.indexOf('ko') === 0) detected = 'ko';
          else if (lang.indexOf('zh') === 0) {
            detected = /hant|tw|hk|mo/.test(lang) ? 'zh-Hant' : 'zh-Hans';
          } else if (lang.indexOf('en') === 0) detected = 'en';
        }
        location.replace(base + (detected || 'en') + '/');
      })();
    </script>
    <meta http-equiv="refresh" content={`0;url=${base}en/`} />
    <link rel="canonical" href={canonical} />
    <title>UOR Waiting Time</title>
  </head>
  <body></body>
</html>
